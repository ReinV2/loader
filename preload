--[[
-- reinhook v1 - loader
    ===========================================================================
    Execute anywhere.

      lobby    ->  small window, one load button
      in match ->  no window, the build runs immediately

    load caches the build to disk and queues a tiny stub with queue_on_teleport,
    so the teleport into the match re-executes it. The build re-queues itself
    afterwards, which keeps every later teleport covered.

    Payload resolution order:
        1. CONFIG.PAYLOAD_URL
        2. embedded source (built in below)
        3. CONFIG.PAYLOAD_FILE
        4. CONFIG.CACHE_FILE / legacy cache paths
]]

local CONFIG = {
    -- Key system. Leave API empty for an embedded build (the payload ships inside
    -- the loader). Set it to your Worker URL and the loader authenticates first
    -- and then fetches the build from the server, so a leaked loader contains no
    -- payload at all.
    API = "",
    KEY_CACHE = "reinhook/key.txt",
    PAYLOAD_URL = "",
    PAYLOAD_FILE = "reinhook_payload_v2.lua",
    CACHE_DIR = "reinhook",
    CACHE_FILE = "reinhook/payload_v2.lua",
    -- paths a previous build (branded rein-hook) cached and queued; still read
    -- and still written so a stub queued before the rename cannot replay an old
    -- build
    LEGACY_FILES = {
        "rein-hook/payload_v2.lua",
        "rein-hook/payload.lua",
    },
    TITLE = "reinhook",
    TAG = "v1",
    HINT = "ready when you are",
}

