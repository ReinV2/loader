    -- In key mode the caption line is hidden (the key box takes its place), so the
    -- detail has to go into the status line or the user only sees "key rejected"
    -- with no reason.
    local function fail(Text, CaptionText)
        local Detail = CaptionText or Text

        if keyMode() and Detail ~= "" and Detail ~= Text then
            SetStatus("bad", Text .. " · " .. Detail)
        else
            SetStatus("bad", Text)
            setCaption(Detail)
        end

        ButtonLabel.Text = "try again"
        Busy = false
    end

    -- The actual load, callable directly. It must NOT go through the click signal:
    -- an RBXScriptSignal has no :Fire(), so re-entering the handler that way threw
    -- right after "key accepted" and the card sat on "loading" forever.
    local function doLoad()
        if Busy then
            return
        end

        Busy = true
        setProgress(0.08, true)
        SetStatus("work", "resolving payload")
        setCaption("reading the build out of the loader")
        ButtonLabel.Text = "loading"

        task.spawn(function()
            local Source, Origin = resolvePayload()

            if not Source then
                if keyMode() then
                    fail("not licensed", tostring(Origin))
                else
                    fail("no payload found", "nothing embedded and no cache on disk - set PAYLOAD_URL")
                end

                return
            end

            local Size = math.floor(#Source / 1024)
            setProgress(0.35)
            SetStatus("work", string.format("%s  ·  %d kb", Origin, Size))

            -- A licensed build is never cached to disk: writing it there would let
            -- an expired key keep running from the copy. Key mode runs in-game only.
            local Queued, OnDisk = false, false

            if not keyMode() then
                Queued, OnDisk = armForTeleport(Source)
            end

            -- Key mode: authenticate here (lobby), then queue a stub that fetches
            -- and runs the build after the teleport. Nothing is written to disk,
            -- and the execute happens in the server instead of the lobby.
            if keyMode() then
                local Queue = getQueueFunction()
                local Url = CONFIG.API .. "/payload?token=" .. tostring(Session) .. "&hwid=" .. hwid()

                if Queue then
                    local Stub = string.format(
                        'getgenv().__reinSession={Token=%q,Hwid=%q,API=%q,Key=%q}; loadstring(game:HttpGet(%q))()',
                        tostring(Session),
                        hwid(),
                        CONFIG.API,
                        tostring(ActiveKey or ""),
                        Url
                    )

                    local Queued = pcall(Queue, Stub)

                    if Queued then
                        setProgress(0.7)
                        SetStatus("work", "queued for the server")
                        task.wait(0.25)
                        succeed()
                        return
                    end
                end

                fail("no queue support", "this executor cannot queue - join a server and run it there")
                return
            end

            if isInGame() then
                setProgress(0.72)
                SetStatus("work", "starting the build")

                -- hand the session to the payload so its heartbeat can re-check
                if keyMode() and Session then
                    GENV().__reinSession = {
                        Token = Session,
                        Hwid = hwid(),
                        API = CONFIG.API,
                        Key = ActiveKey or "",
                    }
                end

                local Ok, Err = runPayload(Source)

                if not Ok then
                    fail("compile error", tostring(Err):sub(1, 80))
                    return
                end

                succeed()
                return
            end

            if Queued then
                setProgress(0.7)
                SetStatus("work", "queued for the teleport")
                task.wait(0.25)
                succeed()
                return
            end

            if OnDisk then
                fail("no queue support", "cached, but this executor cannot queue the build")
            elseif keyMode() then
                fail("run this in game", "licensed builds are not cached - execute it in a server")
            else
                fail("no file access", "this executor cannot write the cache or queue the build")
            end
        end)
    end

