    local function fail(Text, CaptionText)
        local Detail = CaptionText or Text

        if keyMode() and Detail ~= "" and Detail ~= Text then
            SetStatus("bad", Text .. " · " .. Detail)
        else
            SetStatus("bad", Text)
            setCaption(Detail)
        end

        ButtonLabel.Text = "try again"
        Busy = false
    end

    -- The actual load, callable directly. It must NOT go through the click signal:
    -- an RBXScriptSignal has no :Fire(), so re-entering the handler that way threw
    -- right after "key accepted" and the card sat on "loading" forever.
    local function doLoad()
        if Busy then
            return
        end

        Busy = true
        setProgress(0.08, true)
        SetStatus("work", "resolving payload")
        setCaption("reading the build out of the loader")
        ButtonLabel.Text = "loading"

        task.spawn(function()
            local Source, Origin = resolvePayload()

            if not Source then
                if keyMode() then
                    fail("not licensed", tostring(Origin))
                else
                    fail("no payload found", "nothing embedded and no cache on disk - set PAYLOAD_URL")
                end

                return
            end

            local Size = math.floor(#Source / 1024)
            setProgress(0.35)
            SetStatus("work", string.format("%s  ·  %d kb", Origin, Size))

            -- A licensed build is never cached to disk: writing it there would let
            -- an expired key keep running from the copy. Key mode runs in-game only.
            local Queued, OnDisk = false, false

            if not keyMode() then
                Queued, OnDisk = armForTeleport(Source)
            end

            -- Key mode: authenticate here (lobby), then queue a stub that fetches
            -- and runs the build after the teleport. Nothing is written to disk,
            -- and the execute happens in the server instead of the lobby.
            if keyMode() then
                local Queue = getQueueFunction()
                local Url = CONFIG.API .. "/payload?token=" .. tostring(Session) .. "&hwid=" .. hwid()

                if Queue then
                    local Stub = string.format(
                        'getgenv().__reinSession={Token=%q,Hwid=%q,API=%q,Key=%q}; loadstring(game:HttpGet(%q))()',
                        tostring(Session),
                        hwid(),
                        CONFIG.API,
                        tostring(ActiveKey or ""),
                        Url
                    )

                    local Queued = pcall(Queue, Stub)

                    if Queued then
                        setProgress(0.7)
                        SetStatus("work", "queued for the server")
                        task.wait(0.25)
                        succeed()
                        return
                    end
                end

                fail("no queue support", "this executor cannot queue - join a server and run it there")
                return
            end

            if isInGame() then
                setProgress(0.72)
                SetStatus("work", "starting the build")

                -- hand the session to the payload so its heartbeat can re-check
                if keyMode() and Session then
                    GENV().__reinSession = {
                        Token = Session,
                        Hwid = hwid(),
                        API = CONFIG.API,
                        Key = ActiveKey or "",
                    }
                end

                local Ok, Err = runPayload(Source)

                if not Ok then
                    fail("compile error", tostring(Err):sub(1, 80))
                    return
                end

                succeed()
                return
            end

            if Queued then
                setProgress(0.7)
                SetStatus("work", "queued for the teleport")
                task.wait(0.25)
                succeed()
                return
            end

            if OnDisk then
                fail("no queue support", "cached, but this executor cannot queue the build")
            elseif keyMode() then
                fail("run this in game", "licensed builds are not cached - execute it in a server")
            else
                fail("no file access", "this executor cannot write the cache or queue the build")
            end
        end)
    end

    Button.MouseButton1Click:Connect(function()
        if Busy then
            return
        end

        if not apiTrusted() then
            fail('insecure api', 'CONFIG.API must be an https url')
            return
        end

        if not keyMode() or Session then
            doLoad()
            return
        end

        local Key = KeyBox.Text:gsub("%s+", "")

        if #Key < 4 then
            fail("key required", "paste your key, then press load")
            return
        end

        Busy = true
        setProgress(0.08, true)
        SetStatus("work", "checking key")

        task.spawn(function()
            preloadPing()

            local Token, Why = activate(Key)

            if not Token then
                if outOfAttempts() then
                    fail("too many attempts", "kicked - open a ticket")
                    return
                end

                fail("key rejected", tostring(Why))
                return
            end

            Session = Token
            ActiveKey = Key

            if type(writefile) == "function" then
                pcall(writefile, CONFIG.KEY_CACHE, Key)
            end

            setProgress(0.2)
            SetStatus("work", "key accepted")
            Busy = false

            doLoad()
        end)
    end)

    -- drag ------------------------------------------------------------------
    local Dragging, DragStart, StartPos

    Panel.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = Input.Position
            StartPos = Panel.Position
        end
    end)

    Panel.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end

        local Delta = Input.Position - DragStart
        Panel.Position = UDim2.new(
            StartPos.X.Scale, StartPos.X.Offset + Delta.X,
            StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y
        )
    end)

    -- entrance --------------------------------------------------------------
    Panel.Size = UDim2.fromOffset(WIDTH - 12, HEIGHT - 8)
    tween(Panel, 0.22, { GroupTransparency = 0 })
    tween(Panel, 0.24, { Size = UDim2.fromOffset(WIDTH, HEIGHT) })

    return Root
end

------------------------------------------------------------------- bootstrap

local function Bootstrap()
    if isInGame() then
        local Source = resolvePayload()

        if not Source then
            warn("[reinhook] payload missing")
            return
        end

        cachePayload(Source)

        local Ok, Err = runPayload(Source)
        if not Ok then
            warn("[reinhook] " .. tostring(Err))
        end

        return
    end

    local Ok, Err = pcall(BuildGui)
    if not Ok then
        warn("[reinhook] loader gui failed: " .. tostring(Err))
    end
end

-- Deferred: the build is inlined at the bottom of this file as a global string,
-- which is assigned after this line has already executed.
if type(task) == "table" and type(task.defer) == "function" then
    task.defer(Bootstrap)
else
    spawn(function()
        wait()
        Bootstrap()
    end)
end

