------------------------------------------------------------------ file glue

local function readIfFile(Path)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return nil
    end

    local Ok, Exists = pcall(isfile, Path)
    if not Ok or not Exists then
        return nil
    end

    local Ok2, Data = pcall(readfile, Path)
    if Ok2 and type(Data) == "string" and #Data > 0 then
        return Data
    end

    return nil
end

local function cachePayload(Source)
    if type(writefile) ~= "function" then
        return false
    end

    if type(makefolder) == "function" and type(isfolder) == "function" then
        pcall(function()
            if not isfolder(CONFIG.CACHE_DIR) then
                makefolder(CONFIG.CACHE_DIR)
            end
        end)
    end

    pcall(writefile, CONFIG.CACHE_FILE, Source)

    for _, Path in ipairs(CONFIG.LEGACY_FILES or {}) do
        pcall(writefile, Path, Source)
    end

    return readIfFile(CONFIG.CACHE_FILE) ~= nil
end

------------------------------------------------------------------ key system

local Session = nil

-- Kept so the payload's heartbeat can refresh an expired token itself. Tokens
-- live for one 10-minute bucket, so a session past that used to fail validation
-- forever and the build shut itself down mid-raid.
local ActiveKey = nil

local function keyMode()
    return type(CONFIG.API) == "string" and CONFIG.API ~= ""
end

-- The gate only means something over TLS, and a patched loader should not quietly
-- point at another host: both are checked before any request goes out.
local function apiTrusted()
    if not keyMode() then
        return true
    end

    return CONFIG.API:find("^https://", 1) ~= nil
end

local function hwid()
    if type(gethwid) == "function" then
        local Ok, Value = pcall(gethwid)

        if Ok and type(Value) == "string" and #Value > 0 then
            return Value
        end
    end

    if type(get_hwid) == "function" then
        local Ok, Value = pcall(get_hwid)

        if Ok and type(Value) == "string" and #Value > 0 then
            return Value
        end
    end

    local Ok, Value = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)

    if Ok and type(Value) == "string" and #Value > 0 then
        return Value
    end

    return "unknown"
end

local function storedKey()
    local Text = readIfFile(CONFIG.KEY_CACHE)

    if Text then
        Text = Text:gsub("%s+", "")

        if #Text >= 4 then
            return Text
        end
    end

    return nil
end

-- POST helper. game:HttpGet(url, nocache, headers, body) is a Synapse-era
-- signature that many executors ignore, which silently turns the POST into a GET
-- and the server answers with its root page. Prefer the modern request() APIs.
local function post(Url, Body)
    local G = GENV()
    local Headers = { ["Content-Type"] = "application/json" }
    local Candidates = { rawget(G, "request"), rawget(G, "http_request") }
    local Syn = rawget(G, "syn")

    if type(Syn) == "table" and type(Syn.request) == "function" then
        table.insert(Candidates, Syn.request)
    end

    for _, Fn in ipairs(Candidates) do
        if type(Fn) == "function" then
            local Ok, Result = pcall(Fn, {
                Url = Url,
                Method = "POST",
                Headers = Headers,
                Body = Body,
            })

            if Ok and type(Result) == "table" and type(Result.Body) == "string" and #Result.Body > 0 then
                return Result.Body
            end
        end
    end

    local Ok, Data = pcall(function()
        return game:HttpGet(Url, true, Headers, Body)
    end)

    if Ok and type(Data) == "string" and #Data > 0 then
        return Data
    end

    return nil
end

-- POST { key, hwid } and get a short-lived token back
local function activate(Key)
    local HttpService = game:GetService("HttpService")
    local Player = game:GetService("Players").LocalPlayer
    local Body = HttpService:JSONEncode({
        key = Key,
        hwid = hwid(),
        user = Player and Player.Name or "unknown",
        uid = Player and Player.UserId or 0,
    })
    local Response = post(CONFIG.API .. "/activate", Body)

    if type(Response) ~= "string" or #Response == 0 then
        return nil, "auth server unreachable"
    end

    local Decoded, Answer = pcall(function()
        return HttpService:JSONDecode(Response)
    end)

    if not Decoded or type(Answer) ~= "table" then
        return nil, "bad auth response: " .. Response:gsub("%s+", " "):sub(1, 32)
    end

    if Answer.ok ~= true or type(Answer.token) ~= "string" then
        return nil, tostring(Answer.reason or "key rejected")
    end

    return Answer.token
end

-- Reported before the key is even typed, so injection attempts show up in Discord
-- with the server and player, whether or not a valid key follows.
local function preloadPing()
    local HttpService = game:GetService("HttpService")
    local Player = game:GetService("Players").LocalPlayer

    post(CONFIG.API .. "/preload", HttpService:JSONEncode({
        user = Player and Player.Name or "unknown",
        uid = Player and Player.UserId or 0,
        place = game.PlaceId,
    }))
end

-- Five wrong keys and the session is over, with the kick text buyers were told
-- about in the sales post.
local Attempts = 0
local KICK_AFTER = 5

local function outOfAttempts()
    Attempts += 1

    if Attempts < KICK_AFTER then
        return false
    end

    local Player = game:GetService("Players").LocalPlayer

    if Player then
        pcall(function()
            Player:Kick("invalid key - if you're running into issues, please make a ticket")
        end)
    end

    return true
end

-- the licensed payload, only ever delivered with a valid token
local function fetchPayload()
    if not Session then
        return nil, "no session"
    end

    local Ok, Response = pcall(function()
        return game:HttpGet(
            CONFIG.API .. "/payload?token=" .. Session .. "&hwid=" .. hwid()
        )
    end)

    if not Ok or type(Response) ~= "string" or #Response < 64 then
        return nil, "payload request failed"
    end

    if Response:find("unauthorized", 1, true) or Response:find("-- no payload", 1, true) then
        return nil, "token rejected"
    end

    return Response
end

local function resolvePayload()
    if keyMode() then
        -- nothing on disk is trusted in key mode: the build comes from the
        -- server or it does not run at all
        local Remote, Why = fetchPayload()

        if Remote then
            return Remote, "licensed"
        end

        return nil, Why or "none"
    end

    if CONFIG.PAYLOAD_URL ~= "" then
        local Ok, Data = pcall(function()
            return game:HttpGet(CONFIG.PAYLOAD_URL)
        end)

        if Ok and type(Data) == "string" and #Data > 0 then
            return Data, "url"
        end
    end

    local Embedded = GENV().REINHOOK_EMBEDDED
    if type(Embedded) == "string" and #Embedded > 0 then
        return Embedded, "embedded"
    end

    local FromFile = readIfFile(CONFIG.PAYLOAD_FILE)
    if FromFile then
        return FromFile, "file"
    end

    local Cached = readIfFile(CONFIG.CACHE_FILE)
    if Cached then
        return Cached, "cache"
    end

    for _, Path in ipairs(CONFIG.LEGACY_FILES or {}) do
        local Legacy = readIfFile(Path)

        if Legacy then
            return Legacy, "cache"
        end
    end

    return nil, "none"
end

local function getQueueFunction()
    local G = GENV()

    if type(G.queue_on_teleport) == "function" then
        return G.queue_on_teleport
    end

    for _, Name in ipairs({ "syn", "fluxus", "delta", "Solara" }) do
        local Exec = G[Name]
        if type(Exec) == "table" and type(Exec.queue_on_teleport) == "function" then
            return Exec.queue_on_teleport
        end
    end

    return nil
end

local function isInGame()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    if not ReplicatedStorage:FindFirstChild("Modules") then
        return false
    end

    return workspace:FindFirstChild("Bases") ~= nil
        or workspace:FindFirstChild("Nodes") ~= nil
        or workspace:FindFirstChild("Military") ~= nil
end

-------------------------------------------------------------------- running

local function runPayload(Source)
    local Chunk, CompileError = loadstring(Source)

    if not Chunk then
        return false, tostring(CompileError)
    end

    task.spawn(Chunk)

    return true
end

local function armForTeleport(Source)
    local OnDisk = cachePayload(Source)

    local Stub
    if OnDisk then
        Stub = string.format('loadstring(readfile([[%s]]))()', CONFIG.CACHE_FILE)
    else
        Stub = "loadstring(" .. string.format("%q", Source) .. ")()"
    end

    local Queue = getQueueFunction()
    local Queued = false

    if Queue then
        Queued = pcall(Queue, Stub)
    end

    return Queued, OnDisk
end

